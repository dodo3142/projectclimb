[application]

config/name="EgyGameJam26"
run/main_scene="res://Levels/test_map.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://3DPlatformer.png"

[autoload]

PhantomCameraManager="*uid://duq6jhf6unyis"
SimpleGrass="*res://addons/simplegrasstextured/singleton.tscn"
DebugMenu="*uid://cggqb75a8w8r"

[display]

window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/debug_menu/plugin.cfg", "res://addons/godot_state_charts/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/simplegrasstextured/plugin.cfg")

