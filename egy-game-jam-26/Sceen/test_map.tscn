[sub_resource type="GDScript" id="GDScript_1stxn"]
script/source = "extends Area2D

@export var time: Label 


func _on_area_entered(area: Area2D) -> void:
	if area.is_in_group(\"Player\"):
		GameManger.timer.stop_timer()
		var time_to_finish = GameManger.timer.time_elapsed
		var minutes = int(time_to_finish / 60.0)
		var seconds = int(time_to_finish) % 60
		var milliseconds = int((time_to_finish - int(time_to_finish)) * 100)
		# Format text as \"00:00:00\"
		time.text = \"Your Time: \" +\"%02d:%02d:%02d\" % [minutes, seconds, milliseconds]
"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_goxyh"]
size = Vector2(1132, 538)

[sub_resource type="GDScript" id="GDScript_goxyh"]
script/source = "extends Area2D


func _on_area_entered(area: Area2D) -> void:
	if area.is_in_group(\"Player\"):
		GameManger.Restart()
"

